# Caddy gets and renews a free Let's Encrypt HTTPS certificate for {$DOMAIN} automatically.
# DOMAIN=localhost gives a locally trusted test certificate instead.
{
	email {$ACME_EMAIL:admin@example.com}
	# Behind a tunnel/proxy on the Docker network (deploy/docker-compose.tunnel.yml), keep its
	# X-Forwarded-Proto: https so the API sees the real scheme. Direct internet clients are never private IPs.
	servers {
		trusted_proxies static private_ranges
	}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# API → Spring Boot container
	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		# Never cache the service worker or index.html, so updates reach users quickly.
		@nocache path /sw.js /index.html /registerSW.js /manifest.webmanifest
		header @nocache Cache-Control "no-cache"
		# Hashed build files never change.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Single-page app: unknown paths load index.html
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		-Server
	}
}
