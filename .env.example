# Copy to .env for production (deploy/docker-compose.prod.yml). Never commit the real .env.
# Generate random secrets with:  openssl rand -base64 48

# Your domain (its DNS A record must point at the server). Caddy gets the HTTPS certificate automatically.
DOMAIN=crm.example.com
ACME_EMAIL=you@example.com

DB_PASSWORD=change-me
JWT_SECRET=generate-a-long-random-string-of-at-least-32-characters

# First admin account (created only when the database has no users)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# Who may call the API: the website, the Android/iOS app (https://localhost, capacitor://localhost)
# and the desktop app (app://open-crm)
CORS_ORIGINS=https://crm.example.com,https://localhost,capacitor://localhost,app://open-crm

APP_TIMEZONE=Asia/Kolkata

# ARM servers (Oracle Cloud free tier, Raspberry Pi):
# POSTGIS_IMAGE=imresamu/postgis:16-3.5

# AI agent assistant on tickets (summary + suggested reply). See docs/DEPLOY.md -> "AI assistant".
# Local open-source model: add -f deploy/docker-compose.ai.yml (sets AI_PROVIDER=ollama automatically).
# OLLAMA_MODEL=qwen2.5:3b
# Claude API instead (paid, not open source):
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
